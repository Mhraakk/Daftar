# ── پایگاه داده ──
DATABASE_URL="postgresql://daftar:CHANGE_ME@localhost:5432/daftar?schema=public"
POSTGRES_PASSWORD="CHANGE_ME"

# ── برنامه ──
APP_URL="http://192.168.1.100:3000"
# کلید ۳۲ بایتی (hex) برای رمزنگاری اسرار اتصال‌ها:  openssl rand -hex 32
APP_SECRET="CHANGE_ME_64_HEX_CHARS"
SESSION_TTL_HOURS="12"
SESSION_IDLE_MINUTES="60"
# فقط وقتی پشت HTTPS هستید true کنید
COOKIE_SECURE="false"
TZ="Asia/Tehran"

# ── ذخیره‌سازی فایل و پشتیبان ──
STORAGE_DIR="./storage"
BACKUP_DIR="./backups"
MAX_UPLOAD_MB="25"
BACKUP_CRON_HOUR="2"
BACKUP_KEEP="14"

# ── خروجی PDF (مسیر Chromium) ──
CHROMIUM_PATH=""

# ── هوش مصنوعی (اختیاری) ──
# بدون این متغیرها، ارائه‌دهنده از صفحه «مدیریت ← هوش مصنوعی» تنظیم می‌شود (کلید رمزنگاری‌شده در پایگاه داده).
# با تعیین LLM_BASE_URL و LLM_MODEL، ارائه‌دهنده، نشانی، مدل و کلید فقط از همین‌جا خوانده می‌شوند و در فرم قفل‌اند؛
# کلید هرگز در پایگاه داده یا مرورگر ذخیره نمی‌شود. همه ارائه‌دهنده‌های زیر سازگار با OpenAI هستند:
#   Hugging Face: https://router.huggingface.co/v1   (مدل: Qwen/Qwen3.8-27B)
#   OpenRouter:   https://openrouter.ai/api/v1        (مدل: qwen/qwen3.8-27b)
#   DeepSeek:     https://api.deepseek.com/v1         (شناسه مدل را از فهرست مدل‌های حساب خود بردارید)
#   مدل محلی:     http://<host>:11434/v1 (Ollama) یا http://<host>:8080/v1 (llama.cpp)
# LLM_PROVIDER فقط برچسب است (hf | openrouter | deepseek | local)؛ مقدار anthropic یعنی API رسمی Claude.
LLM_PROVIDER=""
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MODEL=""
# مدل امبدینگ برای مرتب‌سازی معنایی منابع «پرسش حقوقی» (اختیاری؛ سرور باید مسیر /embeddings داشته باشد)
LLM_EMBEDDING_MODEL=""
# سقف زمان هر فراخوانی به میلی‌ثانیه (۳۰٬۰۰۰ تا ۷٬۲۰۰٬۰۰۰)
LLM_TIMEOUT_MS=""

# ── حساب مدیر اولیه (فقط در اولین seed) ──
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="CHANGE_ME_STRONG"
